{
    "appId":  "com.jobranger.app",
    "productName":  "Job Ranger",
    "copyright":  "Copyright © 2026 Job Ranger",
    "directories":  {
                        "output":  "release",
                        "buildResources":  "build"
                    },
    "files":  [
                  "dist/**/*",
                  "package.json",
                  "electron-runtime/**/*"
              ],
    "extraMetadata":  {
                          "main":  "electron-runtime/electron/src/main.cjs"
                      },
    "afterSign":  "scripts/notarize.cjs",
    "win":  {
                "target":  [
                               {
                                   "target":  "nsis",
                                   "arch":  [
                                                "x64"
                                            ]
                               }
                           ],
                "icon":  "public/ICON.png",
                "artifactName":  "${productName}-v${version}-windows-${arch}.${ext}",
                "extraResources": [
                                      {
                                        "from": "build/sqlite/sqlite3.exe",
                                        "to": "sqlite3.exe"
                                      },
                                      {
                                        "from": "build/google-oauth",
                                        "to": "google-oauth",
                                        "filter": ["google-desktop-client.json"]
                                      }
                                  ]
            },
    "mac":  {
                "target":  [
                               {
                                   "target":  "dmg",
                                   "arch":  [
                                                "x64",
                                                "arm64"
                                            ]
                               },
                               {
                                   "target":  "zip",
                                   "arch":  [
                                                "x64",
                                                "arm64"
                                            ]
                               }
                           ],
                "category":  "public.app-category.productivity",
                "extraResources": [
                                      {
                                        "from": "build/google-oauth",
                                        "to": "google-oauth",
                                        "filter": ["google-desktop-client.json"]
                                      }
                                  ],
                "icon":  "build/icon.icns",
                "artifactName":  "${productName}-v${version}-macos-${arch}.${ext}",
                "hardenedRuntime":  true,
                "entitlements":  "build/entitlements.mac.plist",
                "entitlementsInherit":  "build/entitlements.mac.plist",
                "gatekeeperAssess":  false
            },
    "dmg":  {
                "artifactName":  "${productName}-v${version}-macos-${arch}.${ext}"
            },
    "nsis":  {
                 "oneClick":  false,
                 "allowToChangeInstallationDirectory":  true,
                 "createDesktopShortcut":  true,
                 "createStartMenuShortcut":  true,
                 "shortcutName":  "Job Ranger",
                 "uninstallDisplayName":  "Job Ranger",
                 "perMachine":  false,
                 "allowElevation":  false,
                 "deleteAppDataOnUninstall":  false,
                 "runAfterFinish":  true
             }
}
