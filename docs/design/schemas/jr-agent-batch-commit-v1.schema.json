{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MythologIQ-Labs-LLC/job-ranger/blob/main/docs/design/schemas/jr-agent-batch-commit-v1.schema.json",
  "title": "jr-agent-batch-commit v1 - design-owner candidate for G2/G3 review",
  "description": "Closed structural completion marker matching current G2 parser naming and fields. Hashes prove content integrity, not actor identity, authority, proof of a Drive transaction, or user consent. Runtime must verify MIME-extension pairs, path normalization collisions, provider folder IDs and original bytes.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "schema_version",
    "batch_id",
    "batch_sha256",
    "batch_bytes",
    "attachments"
  ],
  "properties": {
    "format": {
      "const": "jr-agent-batch-commit"
    },
    "schema_version": {
      "const": 1
    },
    "batch_id": {
      "type": "string",
      "minLength": 7,
      "maxLength": 128,
      "pattern": "^batch_[A-Za-z0-9_-]+$"
    },
    "batch_sha256": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[a-f0-9]{64}$"
    },
    "batch_bytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4194304
    },
    "attachments": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "media_type",
          "bytes",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240,
            "pattern": "^workspace/attachments/(?:[A-Za-z0-9_-][A-Za-z0-9._-]*/)*[A-Za-z0-9_-][A-Za-z0-9._-]*$"
          },
          "media_type": {
            "enum": [
              "application/pdf",
              "text/plain",
              "text/markdown",
              "application/vnd.openxmlformats-officedocument.wordprocessingml.document"
            ]
          },
          "bytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20971520
          },
          "sha256": {
            "type": "string",
            "minLength": 64,
            "maxLength": 64,
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    }
  }
}
