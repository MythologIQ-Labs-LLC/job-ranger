{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MythologIQ-Labs-LLC/job-ranger/blob/main/docs/design/schemas/jr-agent-proposal-v1.schema.json",
  "title": "Job Ranger agent proposal envelope v1 - DRAFT / NON-NORMATIVE",
  "description": "Structural gate only. Does not authorize a model, establish evidence truth, permit import or validate the local export receipt.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "schema_version",
    "proposal_id",
    "status",
    "kind",
    "source_export_id",
    "source_manifest_sha256",
    "source_record_refs",
    "artifact"
  ],
  "properties": {
    "format": {
      "const": "jr-agent-proposal"
    },
    "schema_version": {
      "const": 1
    },
    "proposal_id": {
      "type": "string",
      "minLength": 11,
      "maxLength": 96,
      "pattern": "^pr_[A-Za-z0-9_-]+$"
    },
    "status": {
      "const": "proposed"
    },
    "kind": {
      "enum": [
        "cover_letter_draft",
        "resume_draft",
        "job_notes_draft",
        "worksheet_draft"
      ]
    },
    "source_export_id": {
      "type": "string",
      "minLength": 9,
      "maxLength": 96,
      "pattern": "^ex_[A-Za-z0-9_-]+$"
    },
    "source_manifest_sha256": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[a-f0-9]{64}$"
    },
    "source_record_refs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "record_id",
          "revision"
        ],
        "properties": {
          "record_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9_:-]+$"
          },
          "revision": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          }
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "media_type",
        "text"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "media_type": {
          "const": "text/plain"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 50000
        }
      }
    }
  }
}
