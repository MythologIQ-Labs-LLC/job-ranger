{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MythologIQ-Labs-LLC/job-ranger/blob/main/docs/design/schemas/jr-agent-operation-batch-v1.schema.json",
  "title": "Job Ranger agent workspace operation batch v1 - DRAFT / NON-NORMATIVE",
  "description": "Closed structure only; does not grant permissions, authenticate author, verify local receipts or adjudicate factual claims. No runtime importer exists in this branch. Optional bounded attachment references permit real draft documents; runtime must check actual bytes, path containment and exact batch-local digest membership. A schema-valid hash is not a verified upload.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "schema_version",
    "workspace_id",
    "batch_id",
    "source_export_id",
    "source_manifest_sha256",
    "actor_claim",
    "created_at",
    "previous_batch_id",
    "operations"
  ],
  "properties": {
    "format": {
      "const": "jr-agent-operation-batch"
    },
    "schema_version": {
      "const": 1
    },
    "workspace_id": {
      "type": "string",
      "minLength": 6,
      "maxLength": 128
    },
    "batch_id": {
      "type": "string",
      "minLength": 7,
      "maxLength": 128,
      "pattern": "^batch_[A-Za-z0-9_-]+$"
    },
    "source_export_id": {
      "type": "string",
      "minLength": 9,
      "maxLength": 96,
      "pattern": "^ex_[A-Za-z0-9_-]+$"
    },
    "source_manifest_sha256": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[a-f0-9]{64}$"
    },
    "actor_claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actor_id",
        "display_name"
      ],
      "properties": {
        "actor_id": {
          "type": "string",
          "minLength": 6,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "display_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        }
      }
    },
    "created_at": {
      "type": "string",
      "minLength": 20,
      "maxLength": 32,
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "previous_batch_id": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "minLength": 7,
          "maxLength": 128,
          "pattern": "^batch_[A-Za-z0-9_-]+$"
        }
      ]
    },
